.DS_Store

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local secrets / env (Supabase keys) — keep .env.example, ignore real envs
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.idea/
*.swp

# --- iOS / Capacitor ---
# CocoaPods downloaded dependencies (restored with `pod install`)
ios/App/Pods/
ios/App/Podfile.lock
# Capacitor copies the web build into the native project on `cap sync`
ios/App/App/public/
# Xcode user-specific state and build artifacts
ios/App/build/
ios/App/DerivedData/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/xcuserdata/
