# Supabase backend for the online multiplayer system (duels, leaderboards, friends).
# Copy this file to ".env", paste your project's values, then rebuild.
# Find these in your Supabase project: Settings → API.
#
# Without these, the game still builds and runs fully offline — the online
# features simply stay hidden until configured.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
