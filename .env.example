# Supabase backend for the online multiplayer system (duels, leaderboards, friends).
# Copy this file to ".env", paste your project's values, then rebuild.
# Find these in your Supabase project: Settings → API.
#
# Without these, the game runs fully offline against a built-in LOCAL SIMULATION
# backend: friends, duels (vs a simulated opponent) and leaderboards all work
# with ZERO external servers — ideal for local dev and Xcode testing. Add real
# values below to switch to the live Supabase backend.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: force the local simulation backend even when real creds are present
# (useful for offline QA / demos).
# VITE_OFFLINE_MODE=1
